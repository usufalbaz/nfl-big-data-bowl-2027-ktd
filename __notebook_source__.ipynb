import pandas as pd
import numpy as np

print("⏳ جاري معالجة وتجهيز الأسبوع الأول بالكامل...")

# 1. تحميل اللاعبين ومراكزهم
players = pd.read_csv(f'{DATA_DIR}players.csv')
wr_players = players[players['nfl_position'] == 'WR'][['nfl_id', 'display_name', 'draft_overall_pick']]

# 2. استخراج فيزياء الحركة في الـ Combine (تمرين SPEED_OUT)
combine = pd.read_csv(
    f'{DATA_DIR}combine_tracking.csv',
    usecols=['nfl_id', 'drill_name', 'attempt', 'time', 's', 'a', 'dir']
)
speed_out = combine[combine['drill_name'].str.contains('SPEED_OUT', na=False)]

# حساب خصائص الدوران والفرامل لكل لاعب في الـ Combine
combine_features = []
for nfl_id, group in speed_out.groupby('nfl_id'):
    # أقل سرعة تمثل قمة زاوية الدوران (The Cut Apex)
    min_speed = group['s'].min()
    max_speed = group['s'].max()
    avg_speed = group['s'].mean()
    # كفاءة الكبح والتسارع (الفرق الحركي)
    speed_drop = max_speed - min_speed
    
    combine_features.append({
        'nfl_id': nfl_id,
        'combine_top_speed': max_speed,
        'combine_cut_min_speed': min_speed,
        'combine_speed_drop': speed_drop,
        'combine_speed_retention': (min_speed / max_speed) if max_speed > 0 else 0
    })

combine_df = pd.DataFrame(combine_features)

# 3. استخراج أداء نفس اللاعبين في ماتشات الدوري الحقيقية لمسار OUT
player_play = pd.read_csv(
    f'{DATA_DIR}player_play.csv',
    usecols=['nfl_id', 'route_ran', 'separation_at_pass_forward', 'expected_points_added', 'yards_after_catch']
)
# فلترة مسار OUT فقط للاعبينا
out_routes = player_play[
    (player_play['route_ran'] == 'OUT') & 
    (player_play['nfl_id'].isin(combine_df['nfl_id']))
]

game_metrics = out_routes.groupby('nfl_id').agg(
    routes_run_count=('route_ran', 'count'),
    avg_separation=('separation_at_pass_forward', 'mean'),
    avg_epa=('expected_points_added', 'mean'),
    avg_yac=('yards_after_catch', 'mean')
).reset_index()

# 4. دمج مقاييس نجاح المسيرة (Career Successes)
career = pd.read_csv(f'{DATA_DIR}player_career_successes.csv')[
    ['nfl_id', 'career_games_started', 'pro_bowl_original_ballot', 'ap_all_pro_1st_team']
]

# 5. الدمج الشامل وحساب معادلة KTD
master_df = wr_players.merge(combine_df, on='nfl_id') \
                      .merge(game_metrics, on='nfl_id', how='left') \
                      .merge(career, on='nfl_id', how='left')

# حساب معادلة KTD: نسبة فقدان الكفاءة الحركية من الاختبارات إلى الملعب
# اللاعب ذو الـ KTD المنخفض هو من يصنع مسافة عالية رغم تراجع سرعته في الاختبارات
master_df['avg_separation'] = master_df['avg_separation'].fillna(master_df['avg_separation'].median())
master_df['KTD_Score'] = (master_df['combine_speed_drop'] / (master_df['avg_separation'] + 0.01)).round(2)

# ملء القيم الخالية للمسيرة
master_df['career_games_started'] = master_df['career_games_started'].fillna(0)
master_df['pro_bowl_original_ballot'] = master_df['pro_bowl_original_ballot'].fillna(0)

# حفظ الملف النهائي على Kaggle للأمان التام
master_df.to_csv('/kaggle/working/ktd_wr_metrics.csv', index=False)

print("✅ تم الانتهاء من جميع حسابات الأسبوع الأول بنجاح تام!")
print(f"📁 تم حفظ الجدول الكامل في: /kaggle/working/ktd_wr_metrics.csv")
print(f"📊 إجمالي اللاعبين الذين تم بناء ملفاتهم الفيزيائية: {len(master_df)} لاعب")

print("\n--- 🌟 أفضل 5 صفقات مسروقة (أعلى كفاءة حركية وصناعة مساحة - Low KTD) ---")
print(master_df.sort_values('KTD_Score').head(5)[
    ['display_name', 'draft_overall_pick', 'combine_top_speed', 'avg_separation', 'KTD_Score']
])


import pandas as pd
import numpy as np
from scipy import stats

print("🔬 جاري إجراء الاختبارات الإحصائية للأسبوع الثاني...\n")

# 1. قراءة الجدول الرئيسي المجهز
df = pd.read_csv('/kaggle/working/ktd_wr_metrics.csv')

# فلترة اللاعبين الذين لديهم مشاركات فعلية في مباريات الدوري
active_players = df[df['routes_run_count'] >= 5].copy()

# 2. حساب معاملات الارتباط الإحصائي (Pearson & Spearman)
# اختبار الارتباط بين KTD وصناعة المساحة (Separation)
corr_pearson, p_pearson = stats.pearsonr(active_players['KTD_Score'], active_players['avg_separation'])
corr_spearman, p_spearman = stats.spearmanr(active_players['KTD_Score'], active_players['avg_separation'])

# اختبار الارتباط بين KTD والقيمة الهجومية المضافة (EPA)
corr_epa, p_epa = stats.spearmanr(active_players['KTD_Score'], active_players['avg_epa'])

print("--- 📊 نتائج الإثبات الإحصائي (Hypothesis Testing) ---")
print(f"1. Pearson Correlation (KTD vs Separation): {corr_pearson:.4f} (p-value: {p_pearson:.4e})")
print(f"2. Spearman Rank Correlation (KTD vs Separation): {corr_spearman:.4f} (p-value: {p_spearman:.4e})")
print(f"3. Spearman Rank Correlation (KTD vs EPA): {corr_epa:.4f} (p-value: {p_epa:.4e})")

# 3. مقارنة قوة KTD مقابل سرعة الـ Combine التقليدية المجردة (Combine Top Speed)
corr_speed_sep, _ = stats.spearmanr(active_players['combine_top_speed'], active_players['avg_separation'])
print(f"\n4. Traditional Combine Speed vs Separation: {corr_speed_sep:.4f}")

if abs(corr_spearman) > abs(corr_speed_sep):
    print("\n🎯 انتصار علمي: مقياس KTD يتفوق إحصائياً على سرعة الاختبارات التقليدية في التنبؤ بصناعة المساحة داخل الملعب!")


from sklearn.linear_model import Ridge, LinearRegression
from sklearn.model_selection import KFold, cross_val_score
from sklearn.metrics import mean_squared_error, r2_score

print("🤖 جاري تدريب واختبار النماذج التنبؤية (Machine Learning Validation)...\n")

# تجهيز البيانات للمقارنة العادلة
features_ktd = active_players[['KTD_Score']]
features_trad = active_players[['combine_top_speed']]
target = active_players['avg_separation']

# استخدام 5-Fold Cross Validation لتفادي الـ Overfitting
kf = KFold(n_splits=5, shuffle=True, random_state=42)

# 1. تدريب النموذج المعتمد على KTD
model_ktd = LinearRegression()
ktd_scores_r2 = cross_val_score(model_ktd, features_ktd, target, cv=kf, scoring='r2')
ktd_scores_rmse = np.sqrt(-cross_val_score(model_ktd, features_ktd, target, cv=kf, scoring='neg_mean_squared_error'))

# 2. تدريب النموذج المعتمد على السرعة التقليدية (Benchmark Model)
model_trad = LinearRegression()
trad_scores_r2 = cross_val_score(model_trad, features_trad, target, cv=kf, scoring='r2')
trad_scores_rmse = np.sqrt(-cross_val_score(model_trad, features_trad, target, cv=kf, scoring='neg_mean_squared_error'))

print("--- 📈 مقارنة كفاءة النماذج (5-Fold Cross Validation) ---")
print(f"🔹 KTD Model Mean R²: {ktd_scores_r2.mean():.4f} (RMSE: {ktd_scores_rmse.mean():.4f} yds)")
print(f"🔸 Traditional Combine Speed R²: {trad_scores_r2.mean():.4f} (RMSE: {trad_scores_rmse.mean():.4f} yds)")

# تدريب النموذج النهائي واستخراج المعاملات الرياضية
final_model = LinearRegression().fit(features_ktd, target)
print(f"\n📐 المعادلة التنبؤية النهائية: Expected Separation = {final_model.intercept_:.2f} + ({final_model.coef_[0]:.2f} * KTD)")


from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score, accuracy_score, classification_report
from sklearn.model_selection import cross_val_predict

print("🎯 جاري اختبار تصنيف فئات النخبة (Draft Tier Classification)...\n")

# 1. تحديد فئة النخبة: اللاعبين الذين حققوا صناعة مساحة أعلى من المتوسط العام
median_sep = active_players['avg_separation'].median()
active_players['is_elite_separator'] = (active_players['avg_separation'] >= median_sep).astype(int)

# 2. تجهيز الميزات المركبة (KTD + سرعة الاختبار + نسبة استبقاء السرعة)
X_ktd = active_players[['KTD_Score', 'combine_speed_retention']]
X_trad = active_players[['combine_top_speed']]
y = active_players['is_elite_separator']

# 3. تدريب نموذج التصنيف باستخدام Logistic Regression
clf_ktd = LogisticRegression(random_state=42)
clf_trad = LogisticRegression(random_state=42)

# توقع الفئات عبر Out-Of-Fold Cross Validation
y_pred_ktd = cross_val_predict(clf_ktd, X_ktd, y, cv=5, method='predict_proba')[:, 1]
y_pred_trad = cross_val_predict(clf_trad, X_trad, y, cv=5, method='predict_proba')[:, 1]

# 4. حساب دقة التنبؤ والـ ROC-AUC
auc_ktd = roc_auc_score(y, y_pred_ktd)
auc_trad = roc_auc_score(y, y_pred_trad)

acc_ktd = accuracy_score(y, (y_pred_ktd >= 0.5).astype(int))
acc_trad = accuracy_score(y, (y_pred_trad >= 0.5).astype(int))

print(f"📊 إجمالي اللاعبين المؤهلين للاختبار: {len(active_players)} لاعب (المتوسط الفاصل للمساحة: {median_sep:.2f} ياردة)\n")
print("--- 🏆 مقارنة دقة تصنيف لاعبي النخبة (Classification Performance) ---")
print(f"🔹 KTD Engine Model: ROC-AUC = {auc_ktd:.3f} | Accuracy = {acc_ktd * 100:.1f}%")
print(f"🔸 Traditional Speed:  ROC-AUC = {auc_trad:.3f} | Accuracy = {acc_trad * 100:.1f}%")

if auc_ktd > auc_trad:
    lift = ((auc_ktd - auc_trad) / auc_trad) * 100
    print(f"\n🚀 تفوق ساحق: مقياس KTD يحقق قفزة تنبؤية بنسبة {lift:.1f}% مقارنة بسرعة الاختبارات التقليدية!")


print("🏷️ جاري تصنيف لاعبي الـ Draft لعام 2027 إلى الفئات الثلاث الاستراتيجية...\n")

# تصنيف اللاعبين بناءً على شرائح الـ KTD Score (Tiers)
def assign_draft_tier(row):
    if row['KTD_Score'] <= 1.40:
        return 'Tier 1: High-Translation Value (Steal Potential)'
    elif row['KTD_Score'] <= 2.00:
        return 'Tier 2: Baseline Operational Translator'
    else:
        return 'Tier 3: Track-Speed Trap (High Bust Risk)'

master_df['Draft_Tier'] = master_df.apply(assign_draft_tier, axis=1)

# طباعة ملخص توزيع الفئات
tier_summary = master_df['Draft_Tier'].value_counts()
print("--- 📋 توزيع لاعبي الـ 106 على فئات الدرافت ---")
for tier, count in tier_summary.items():
    pct = (count / len(master_df)) * 100
    print(f"• {tier}: {count} لاعب ({pct:.1f}%)")

# حفظ ملف البيانات المحدث رسمياً متضمناً الفئات
master_df.to_csv('/kaggle/working/ktd_wr_metrics.csv', index=False)
print("\n💾 تم تحديث وحفظ الملف الشامل في: /kaggle/working/ktd_wr_metrics.csv")


import matplotlib.pyplot as plt
import seaborn as sns

# ضبط النمط الجمالي الاحترافي للرسومات
plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')
fig, ax = plt.subplots(figsize=(10, 6), dpi=150)

# 1. رسم منحنى التشتت بين مقياس KTD وصناعة المساحة الحقيقية
colors = {
    'Tier 1: High-Translation Value (Steal Potential)': '#2ecc71', # أخضر (صفقات نخبة)
    'Tier 2: Baseline Operational Translator': '#3498db',         # أزرق (أداء معتاد)
    'Tier 3: Track-Speed Trap (High Bust Risk)': '#e74c3c'         # أحمر (فخ سرعة)
}

for tier, color in colors.items():
    subset = master_df[master_df['Draft_Tier'] == tier]
    ax.scatter(
        subset['KTD_Score'], 
        subset['avg_separation'], 
        c=color, 
        label=tier, 
        s=70, 
        alpha=0.85, 
        edgecolors='black', 
        linewidth=0.5
    )

# 2. خط الاتجاه الانحداري (Trendline)
sns.regplot(
    data=master_df, 
    x='KTD_Score', 
    y='avg_separation', 
    scatter=False, 
    ax=ax, 
    color='#2c3e50', 
    line_kws={'linestyle': '--', 'linewidth': 2, 'label': 'Inverse Trendline (Spearman r = -0.54)'}
)

# 3. إبراز اللاعبين النخبة بالأسماء (Annotations)
top_steals = master_df.sort_values('KTD_Score').head(3)
for _, row in top_steals.iterrows():
    ax.annotate(
        f"{row['display_name']} (Pick {int(row['draft_overall_pick']) if pd.notnull(row['draft_overall_pick']) else 'UDFA'})\nKTD: {row['KTD_Score']:.2f}",
        xy=(row['KTD_Score'], row['avg_separation']),
        xytext=(row['KTD_Score'] + 0.1, row['avg_separation'] + 0.3),
        fontsize=8,
        fontweight='bold',
        bbox=dict(boxstyle="round,pad=0.3", fc="#ecf0f1", ec="#2ecc71", lw=1.5),
        arrowprops=dict(arrowstyle="->", connectionstyle="arc3,rad=0.2", color="#27ae60", lw=1.2)
    )

# التنسيق النهائي للرسم
